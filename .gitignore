# ==========================================
# Spring Boot + Angular | STS/Eclipse
# Root-level .gitignore
# ==========================================

# === Eclipse / STS Workspace Metadata ===
.metadata/
.apt_generated/
.sts4-cache/
.springBeans
.factorypath

# === Eclipse Project Files ===
.project
.classpath
.settings/

# === Maven Build Output ===
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# === Gradle Build Output ===
build/
!**/src/main/**/build/
!**/src/test/**/build/
.gradle/

# === Angular / Node ===
node_modules/
dist/
tmp/
out-tsc/
.angular/cache/

# === Package Manager Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Log / Temp / Backup Files ===
*.log
*.tmp
*.bak
hs_err_pid*.log

# === IntelliJ IDEA ===
.idea/
*.iws
*.iml
*.ipr

# === VS Code ===
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# === NetBeans ===
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# === Testing / Coverage ===
/coverage/
/test-output/
/testem.log

# === OS Files ===
.DS_Store
Thumbs.db
